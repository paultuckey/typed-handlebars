# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Exclude RustRover
.idea/

todo.md
todo-archive.md

# The consumer test stands in for a fresh `cargo add`, so it resolves dependencies from scratch
# every run rather than replaying a pinned set.
consumer-test/Cargo.lock
